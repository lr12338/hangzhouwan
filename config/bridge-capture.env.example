# bridge_capture_app 环境变量示例（复制到 /etc/hangzhouwan/bridge-capture.env）
# 真实 RTSP URL 仅放此文件，不入 Git。日志自动脱敏。

# 北通航孔抓拍流 URL（优先直接 RTSP；备选 HTTP-FLV/RTMP）
CAPTURE_NORTH_URL=rtsp://user:password@camera-north:554/Streaming/Channels/101

# 南通航孔抓拍流 URL
CAPTURE_SOUTH_URL=rtsp://user:password@camera-south:554/Streaming/Channels/101

# 可选：动态 bmodel 路径覆盖（默认 /opt/hangzhouwan/current/weights/yolov7.bmodel）
# HZW_CAPTURE_BMODEL=/data/hangzhouwan/bridge/weights/yolov7.bmodel
