[Unit]
Description=Hangzhou Bay Video Pipeline Service (Dual Stream)
Requires=hangzhouwan-business.service
After=hangzhouwan-business.service
PartOf=hangzhouwan.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=linaro
Group=linaro
WorkingDirectory=/opt/hangzhouwan/current
EnvironmentFile=/etc/hangzhouwan/video.env
ExecStart=/opt/hangzhouwan/current/bin/dual_stream_app \
  --config /etc/hangzhouwan/application.yaml \
  --enable-business \
  --business-socket /run/hangzhouwan/business.sock
Restart=on-failure
RestartSec=5
LimitNOFILE=8192
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=15
RuntimeDirectory=hangzhouwan
RuntimeDirectoryMode=0755
StateDirectory=hangzhouwan
LogsDirectory=hangzhouwan
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hangzhouwan.target
