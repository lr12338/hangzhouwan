[Unit]
Description=Hangzhou Bay Controlled Maintenance Restart
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=hangzhouwan
WorkingDirectory=/opt/hangzhouwan/current
EnvironmentFile=/etc/hangzhouwan/business.env
EnvironmentFile=/etc/hangzhouwan/video.env
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hangzhouwan/current/venv/bin/python3 -m services.monitoring.controlled_maintenance
TimeoutStartSec=190
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/hangzhouwan /data/hangzhouwan/monitor
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
SyslogIdentifier=hangzhouwan-maintenance
