[Unit]
Description=Hangzhou Bay Business Enrichment Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linaro
Group=linaro
WorkingDirectory=/home/linaro/hangzhouwan-orign/hangzhouwan
EnvironmentFile=/data/hangzhouwan/config/business.env
ExecStart=/data/hangzhouwan/venv/bin/python3 -m services.business_enrichment.app
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3
LimitNOFILE=1024
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
