[Unit]
Description=Hangzhou Bay Business Enrichment Service (Sidecar)
After=network-online.target
Wants=network-online.target
PartOf=hangzhouwan.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=linaro
Group=linaro
WorkingDirectory=/opt/hangzhouwan/current
EnvironmentFile=/etc/hangzhouwan/business.env
ExecStart=/opt/hangzhouwan/current/venv/bin/python3 \
  -m services.business_enrichment.app \
  --config /etc/hangzhouwan/application.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
KillSignal=SIGTERM
TimeoutStartSec=30
TimeoutStopSec=15
StateDirectory=hangzhouwan
LogsDirectory=hangzhouwan
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hangzhouwan.target
