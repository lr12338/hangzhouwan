# 杭州湾 BM1684 边缘部署 · 敏感环境变量示例
# 复制为 .env（已 gitignore）并填入真实值；.env 不得提交仓库。
# 真实部署请放置于 /data/hangzhouwan/config/.env（权限 600）。

# 视频流输入（RTSP），按路 A / B 分别配置
STREAM_A_INPUT_URL=
STREAM_B_INPUT_URL=

# 推流输出（RTMP），按路 A / B 分别配置
STREAM_A_OUTPUT_URL=
STREAM_B_OUTPUT_URL=

# AIS / MQTT 凭据
AIS_MQTT_CLIENT_ID=
AIS_MQTT_USERNAME=
AIS_MQTT_PASSWORD=

# 船名查询服务（端点 + 令牌，默认空则不调用正式服务）
SHIP_NAME_API_ENDPOINT=
SHIP_NAME_API_TOKEN=
